rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /responses/{responseId} {
      // Sofía puede enviar solo respuestas con los campos esperados.
      allow create: if
        request.resource.data.keys().hasOnly(['letters', 'talk', 'message', 'createdAt']) &&
        request.resource.data.keys().hasAll(['letters', 'talk', 'message', 'createdAt']) &&
        request.resource.data.letters in ['Sí, quiero más cartas', 'No, ya no quiero más'] &&
        request.resource.data.talk in ['yes', 'no'] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 1000;
      // Solo el correo administrador puede leer o administrar respuestas.
      allow read, update, delete: if request.auth != null &&
        request.auth.token.email == 'PON_AQUI_TU_CORREO_ADMIN';
    }
  }
}
